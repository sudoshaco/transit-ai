# =============================================================================
# Transit AI — Environment Configuration
# Kopiere zu .env und passe Werte an. NIEMALS .env committen.
# =============================================================================

# --- App ---------------------------------------------------------------------
ENV=production
DEBUG=false
API_URL=http://localhost
APP_BASE_URL=https://your-domain.example

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=transitai
POSTGRES_USER=transitai_app
# 32+ Zeichen, alphanumerisch + Sonderzeichen. Generierung: ./scripts/rotate-secrets.sh
POSTGRES_PASSWORD=CHANGEME_strong_password_min_32_chars

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=CHANGEME_strong_password_min_32_chars
REDIS_URL=redis://:CHANGEME_strong_password_min_32_chars@redis:6379

# --- LLM Routing -------------------------------------------------------------
# hybrid_free  = Groq primary, Ollama fallback
# cloud_only   = nur Groq
# local_only   = nur Ollama
LLM_MODE=hybrid_free
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Groq Free Tier — kostenlos: https://console.groq.com (14.400 req/Tag)
GROQ_API_KEY=gsk_your_groq_key_here

# --- Deutsche Bahn API Marketplace (optional) --------------------------------
# Kostenlos registrieren: https://developers.deutschebahn.com
# Pfade verweisen auf Mounts in /run/secrets/ (siehe docker-compose)
DB_API_KEY=your_db_api_key
DB_CLIENT_ID=your_db_client_id
DB_API_BASE=https://apis.deutschebahn.com/db-api-marketplace/apis
DB_CERT_PATH=/run/secrets/transit-ai-cert.pem
DB_KEY_PATH=/run/secrets/transit-ai-key.pem

# --- Self-hosted db-rest (HAFAS Wrapper) -------------------------------------
DBREST_BASE=http://db-rest:3000

# --- Geocoding ---------------------------------------------------------------
NOMINATIM_BASE=https://nominatim.openstreetmap.org

# --- Auth & Sessions ---------------------------------------------------------
# Generierung: ./scripts/rotate-secrets.sh
JWT_SECRET=CHANGEME_jwt_secret_min_64_chars
CSRF_SECRET=CHANGEME_csrf_secret_min_48_chars
JWT_ALG=HS256
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# --- CORS / Trusted Hosts ----------------------------------------------------
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# --- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_CALLS=30
RATE_LIMIT_PERIOD=60

# --- E-Mail (Resend, optional) -----------------------------------------------
# https://resend.com — für Auth-E-Mails (Verify, Password Reset)
RESEND_API_KEY=re_your_resend_key
RESEND_FROM=noreply@your-domain.example
